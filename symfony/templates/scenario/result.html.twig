{% extends 'base.html.twig' %}

{% block title %}{{ scenario.title }} — Fiche de résultat{% endblock %}

{% block body %}
    <main>
        <h1 data-testid="scenario-title">{{ scenario.title }}</h1>
        <p class="parameters-version">
            Version du jeu de paramètres :
            <span data-testid="parameters-version">{{ parametersVersion }}</span>
        </p>

        <p data-testid="displayed-views">
            Vue(s) affichée(s) :
            {%- for view in result.views %}
                <span class="view-tag" data-view="{{ view }}">{{ view }}</span>{{ not loop.last ? ',' }}
            {%- endfor %}
        </p>

        <section data-testid="scenario-lines">
            <h2>Lignes du scénario</h2>
            {% for line in result.lines %}
                <article data-testid="scenario-line" data-line="{{ line.lineId }}">
                    <p class="line-funder">
                        Financeur : <span data-testid="line-funder">{{ funders[line.lineId] }}</span>
                        — volume {{ line.volume }}
                    </p>
                    <div class="views-grid">
                        {% for view in result.views %}
                            <div class="view-block" data-testid="line-view" data-view="{{ view }}">
                                <h3 data-testid="view-name">{{ view }}</h3>
                                {{ include('scenario/_horizons.html.twig', { cells: line.results[view], horizons: result.horizons }) }}
                            </div>
                        {% endfor %}
                    </div>
                </article>
            {% endfor %}
        </section>

        <section data-testid="aggregate-section">
            <h2>Agrégat</h2>
            <div class="views-grid">
                {% for view in result.views %}
                    <div class="view-block" data-testid="aggregate-view" data-view="{{ view }}">
                        <h3 data-testid="view-name">{{ view }}</h3>
                        {{ include('scenario/_horizons.html.twig', { cells: result.aggregate[view], horizons: result.horizons }) }}
                    </div>
                {% endfor %}
            </div>
        </section>
    </main>
{% endblock %}
