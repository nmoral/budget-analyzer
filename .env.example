# Projet budget-analyser — P=5 (registre CLAUDE.md)
# Ports au format FPYYY : F=famille service, P=5 (projet), YYY=worktree (000 = base)
#   web (F=4) -> 45YYY   db (F=5) -> 55YYY
# Copier en .env et ajuster YYY selon le worktree pour éviter toute collision.

COMPOSE_PROJECT_NAME=budget-analyser

WEB_PORT=45000
DB_PORT=55000

POSTGRES_DB=budget
POSTGRES_USER=budget
POSTGRES_PASSWORD=change-me
